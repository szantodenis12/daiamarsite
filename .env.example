# Copy to .env.local for local development. On Vercel set these in Project → Settings → Environment Variables.

# Neon Postgres. Added automatically when Neon is connected from the Vercel Marketplace (pick the EU region, aws-eu-central-1).
# Leave empty locally to store leads in .data/db.json instead.
DATABASE_URL=

# Admin login at /admin/. ADMIN_SECRET signs the session cookie: generate with `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional: signs the "form shown at" token that measures the minimum fill time of the public forms. Falls back to
# ADMIN_SECRET when empty. Generate with `openssl rand -hex 32`.
FORM_SECRET=

# Optional: email for every new lead, the weekly summary, offers and the newsletter confirmation (Resend). LEAD_NOTIFY_TO accepts
# several addresses separated by commas; addresses saved in /admin/setari/ take priority over it.
# LEAD_NOTIFY_FROM must use a domain verified in Resend, e.g. "Site Daiamar <site@daiamar.ro>".
# Without RESEND_API_KEY newsletter signups stay "pending" and are confirmed by hand in /admin/abonati/.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# Weekly summary (/api/cron/weekly/, Mondays). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with `openssl rand -hex 32`. Without it the cron endpoint answers 401.
CRON_SECRET=

# Documents uploaded at /trimite-documente/ go to a private Vercel Blob store. Added automatically when Blob is connected
# (Vercel → Storage → Blob → Connect to project). Leave empty locally to store files in .data/uploads/ instead.
BLOB_READ_WRITE_TOKEN=

# Optional: Google Tag Manager container (GA4 and ads tags live inside GTM). Loaded only when set.
NEXT_PUBLIC_GTM_ID=

# Demo/preview only: the deploy's own address (offer links, QR, e-mails). Leave empty in production (www.daiamar.ro).
NEXT_PUBLIC_SITE_URL=
